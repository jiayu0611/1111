<Window x:Class="_1111.MyDocumentViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1111"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="MyDocumentViewer" Height="450" Width="800">
    <DockPanel>
        <ToolBarTray Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" DockPanel.Dock="Top" Background="#FF9EB7AD">
            <ToolBar x:Name="ApplicationToolbar" Height="40" Width="184" Background="#FF78BBCC">
                <Button x:Name="NewButton" Height="38" Width="38" Command="ApplicationCommands.New">
                    <Image Height="32" Width="32" Source="/nwebutton.png"/>
                </Button>
                <Button x:Name="OpenButton" Height="38" Width="38" Command="ApplicationCommands.Open">
                    <Image Height="32" Width="32" Source="/openbutton.png"/>
                </Button>
                <Button x:Name="SaveButton" Height="38" Width="38" Command="ApplicationCommands.Save">
                    <Image Height="32" Width="32" Source="/savebutton.png"/>
                </Button>
                <Button x:Name="TrashButton" Height="38" Width="38" >
                    <Image Height="32" Width="32" Source="/trashbutton.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolbar" Height="40" Width="612" Background="#FF6E6FBB">
                <ToggleButton x:Name="BoldButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/img/bold.png"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/italic-removebg-preview.png" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/underline-removebg-preview.png" />
                </ToggleButton>
                <xctk:ColorPicker x:Name="FontColorPicker" Width="160" Height="38"/>
                <ComboBox x:Name="FontFamilyComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="38" Margin="5,0,0,0"/>
                <ComboBox x:Name="FontSizeComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50" Height="38" Margin="5,0,0,0"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="30" DockPanel.Dock="Bottom" Background="#FF5B5377"/>
        <RichTextBox x:Name="MainRichTextBox" Background="#FF8DB8C3">
            <FlowDocument/>
        </RichTextBox>
    </DockPanel>
</Window>
